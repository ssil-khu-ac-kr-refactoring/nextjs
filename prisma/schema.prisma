generator client {
  provider = "prisma-client-js"
  // 커스텀 출력 경로. pnpm은 client를 .pnpm 가상스토어 안에 생성하므로
  // 최상위 node_modules/.prisma 가 없다. 소스 트리에 고정 출력해야
  // Next standalone 파일 트레이싱이 client + 쿼리엔진(.so.node)을 확실히 번들한다.
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Research {
  id          String         @id @default(cuid())
  title       String
  description String?
  status      ResearchStatus @default(IN_PROGRESS)
  startDate   DateTime?
  endDate     DateTime?
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
  imageUrl    String?
  contentHtml String?
  published   Boolean        @default(false)
  order       Int            @default(0)
}

model Outcome {
  id          String   @id @default(cuid())
  slug        String   @unique
  title       String
  description String?
  imageUrl    String?
  contentHtml String?
  published   Boolean  @default(true)
  order       Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model News {
  id          String   @id @default(cuid())
  title       String
  description String
  imageUrl    String?
  publishedAt DateTime @default(now())
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  contentHtml String?
}

model Person {
  id          Int      @id @default(autoincrement())
  name        String
  position    String
  description String?
  image       String?
  email       String   @unique
  degree      String?
  role        Role
  order       Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model HomePageContent {
  id             Int     @id @default(1)
  heroTitle      String
  heroSubtitle   String
  heroParagraph  String
  aboutTitle     String
  aboutParagraph String
  newsTitle      String
  newsSubtitle   String
  fontFamily     String?
}

model SliderImage {
  id        Int      @id @default(autoincrement())
  imageUrl  String
  altText   String?
  order     Int      @default(0)
  createdAt DateTime @default(now())
}

model Asset {
  id           String         @id @default(cuid())
  url          String
  originalName String?
  mime         String?
  size         Int?
  ownerType    AssetOwnerType
  ownerId      String
  tag          String?
  createdAt    DateTime       @default(now())

  @@index([ownerType, ownerId])
}

model Contact {
  id          Int      @id @default(autoincrement())
  labNameKo   String
  labNameEn   String
  addressKo   String
  addressEn   String
  mapEmbedUrl String
  updatedAt   DateTime @updatedAt
}

model AboutContent {
  page      String   @id
  data      Json
  updatedAt DateTime @updatedAt
}

model Publication {
  id        Int      @id @default(autoincrement())
  title     String
  authors   String
  venue     String?
  year      Int
  month     Int?
  url       String?
  pdfUrl    String?
  // 분류: SCI(SCI 논문/Journal) > OTHER(기타 Publication) > CONFERENCE(학회 초록/Conference)
  category  String   @default("SCI")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([year], map: "idx_publication_year")
  @@index([category], map: "idx_publication_category")
}

model BoardTab {
  id          Int         @id @default(autoincrement())
  name        String      @unique
  slug        String      @unique
  description String?
  order       Int         @default(0)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  posts       BoardPost[]
}

model BoardPost {
  id          String    @id @default(cuid())
  title       String
  description String
  contentHtml String?
  imageUrl    String?
  published   Boolean   @default(false)
  publishedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  tabId       Int
  tab         BoardTab  @relation(fields: [tabId], references: [id])
}

// SPIS average-potential rows parsed from the All_node sheet.
// Long format: one row per (env, resistance, day/night, node0 material,
// node1/boom material, node) -> average potential value.
model SpisPotential {
  id        Int         @id @default(autoincrement())
  datasetId String      @default("DMSP_ONLY") @map("dataset_id")
  dataset   SpisDataset @relation(fields: [datasetId], references: [id], onDelete: Restrict)
  envId     String?     @map("env_id")
  env       String // e.g. "AUR"
  res       String // "R0" | "R1"
  dn        String // "DAY" | "NGT"
  node0Mat  String      @map("node0_mat")
  node1Mat  String      @map("node1_mat")
  node      Int // 0 | 1
  avPot     Float       @map("av_pot")
  lt        Float? // local time 0..24 (geographic); converted to longitude at render time
  lat       Float? // latitude -90..90 (optional)
  // Environment parameters (client's real data format — all optional)
  condSolar String?     @map("cond_solar") // e.g. "SOLARmin" | "SOLARmax"
  kp        String? // e.g. "2lt4"
  eN        Float?      @map("e_n") // electron density
  eT        Float?      @map("e_t") // electron temperature
  iN        Float?      @map("i_n") // ion density
  iT        Float?      @map("i_t") // ion temperature
  dmspEN    Float?      @map("dmsp_e_n")
  dmspET    Float?      @map("dmsp_e_t")
  dmspIN    Float?      @map("dmsp_i_n")
  dmspIT    Float?      @map("dmsp_i_t")
  iriEN     Float?      @map("iri_e_n")
  iriET     Float?      @map("iri_e_t")
  iriIN     Float?      @map("iri_i_n")
  iriIT     Float?      @map("iri_i_t")
  form      String? // satellite form (CSV "type"), e.g. "3U" | "3U+Boom"
  // 인식되지 않은(미지의) 엑셀 컬럼 전부 — { 원본헤더: 값 } JSON. 새 인자 자동 수용용.
  extras    Json?       @map("extras")

  @@index([datasetId])
  @@index([datasetId, envId])
  @@index([node0Mat, node1Mat, res, node, dn])
  @@map("spis_potentials")
}

model SpisDataset {
  id               String          @id
  displayName      String          @map("display_name")
  description      String?
  rowCount         Int             @default(0) @map("row_count")
  environmentCount Int             @default(0) @map("environment_count")
  materialCount    Int             @default(0) @map("material_count")
  potentialMin     Float?          @map("potential_min")
  potentialMax     Float?          @map("potential_max")
  createdAt        DateTime        @default(now()) @map("created_at")
  updatedAt        DateTime        @updatedAt @map("updated_at")
  potentials       SpisPotential[]

  @@map("spis_datasets")
}

enum ResearchStatus {
  IN_PROGRESS
  COMPLETED
}

enum Role {
  PROFESSOR
  CURRENT
  ALUMNI
}

enum AssetOwnerType {
  RESEARCH
  NEWS
}
