generator client {
  provider = "prisma-client-js"
  // 커스텀 출력 경로. pnpm은 client를 .pnpm 가상스토어 안에 생성하므로
  // 최상위 node_modules/.prisma 가 없다. 소스 트리에 고정 출력해야
  // Next standalone 파일 트레이싱이 client + 쿼리엔진(.so.node)을 확실히 번들한다.
  output = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Research {
  id          String         @id @default(cuid())
  title       String
  description String?
  status      ResearchStatus @default(IN_PROGRESS)
  startDate   DateTime?
  endDate     DateTime?
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
  imageUrl    String?
  contentHtml String?
  published   Boolean        @default(false)
  order       Int            @default(0)
}

model Outcome {
  id          String   @id @default(cuid())
  slug        String   @unique
  title       String
  description String?
  imageUrl    String?
  contentHtml String?
  published   Boolean  @default(true)
  order       Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model News {
  id          String   @id @default(cuid())
  title       String
  description String
  imageUrl    String?
  publishedAt DateTime @default(now())
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  contentHtml String?
}

model Person {
  id          Int      @id @default(autoincrement())
  name        String
  position    String
  description String?
  image       String?
  email       String   @unique
  degree      String?
  role        Role
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model HomePageContent {
  id             Int    @id @default(1)
  heroTitle      String
  heroSubtitle   String
  heroParagraph  String
  aboutTitle     String
  aboutParagraph String
  newsTitle      String
  newsSubtitle   String
  fontFamily   String?  
}

model SliderImage {
  id        Int      @id @default(autoincrement())
  imageUrl  String
  altText   String?
  order     Int      @default(0)
  createdAt DateTime @default(now())
}

model Asset {
  id           String         @id @default(cuid())
  url          String
  originalName String?
  mime         String?
  size         Int?
  ownerType    AssetOwnerType
  ownerId      String
  tag          String?
  createdAt    DateTime       @default(now())

  @@index([ownerType, ownerId])
}

model Contact {
  id          Int      @id @default(autoincrement())
  labNameKo   String
  labNameEn   String
  addressKo   String
  addressEn   String
  mapEmbedUrl String
  updatedAt   DateTime @updatedAt
}

model AboutContent {
  page       String   @id
  data       Json
  updatedAt  DateTime @updatedAt
}

model Publication {
  id        Int      @id @default(autoincrement())
  title     String
  authors   String
  venue     String?
  year      Int
  month     Int?
  url       String?
  pdfUrl    String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([year], map: "idx_publication_year")
}

model BoardTab {
  id          Int         @id @default(autoincrement())
  name        String      @unique
  slug        String      @unique
  description String?
  order       Int         @default(0)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  posts       BoardPost[]
}

model BoardPost {
  id          String    @id @default(cuid())
  title       String
  description String
  contentHtml String?
  imageUrl    String?
  published   Boolean   @default(false)
  publishedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  tabId       Int
  tab         BoardTab  @relation(fields: [tabId], references: [id])
}

// SPIS average-potential rows parsed from the All_node sheet.
// Long format: one row per (env, resistance, day/night, node0 material,
// node1/boom material, node) -> average potential value.
model SpisPotential {
  id       Int    @id @default(autoincrement())
  env      String                      // e.g. "AUR"
  res      String                      // "R0" | "R1"
  dn       String                      // "DAY" | "NGT"
  node0Mat String @map("node0_mat")
  node1Mat String @map("node1_mat")
  node     Int                         // 0 | 1
  avPot    Float  @map("av_pot")
  lt       Float?                       // local time 0..24 (geographic); converted to longitude at render time
  lat      Float?                       // latitude -90..90 (optional)

  @@index([node0Mat, node1Mat, res, node, dn])
  @@map("spis_potentials")
}

enum ResearchStatus {
  IN_PROGRESS
  COMPLETED
}

enum Role {
  PROFESSOR
  CURRENT
  ALUMNI
}

enum AssetOwnerType {
  RESEARCH
  NEWS
}
